# Copy this file to ".env" (same folder as this file) and fill in the values.
# ".env" is git-ignored. NEVER commit it, and never paste real keys into this file.

# development | production
TRUWAVE_ENV=development

# ML layer: tfidf (default MVP model) | mock (explicit development/test substitute)
ML_PROVIDER=tfidf
# ML_MODEL_PATH=ml/artifacts/fever_tfidf_logreg.joblib

# Evidence layer: google | fixture
#   google  = real Google Fact Check Tools API (needs FACTCHECK_API_KEY)
#   fixture = canned demo/test data, no network (never a substitute for google)
EVIDENCE_PROVIDER=google

# Google Fact Check Tools API key (Google Cloud Console -> APIs & Services -> Credentials)
FACTCHECK_API_KEY=

# --- Optional tuning (defaults shown) ---
# FACTCHECK_LANGUAGE=en
# FACTCHECK_TIMEOUT_S=5
# FACTCHECK_PAGE_SIZE=10
# FACTCHECK_MAX_ATTEMPTS=2
# EVIDENCE_TIMEOUT_S=8
# EVIDENCE_MIN_RELEVANCE=0.5
# ML_TIMEOUT_S=5
# ML_STRONG_THRESHOLD=0.80
# MAX_SOURCES=5
